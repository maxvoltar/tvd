{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Watch SCSS",
      "type": "npm",
      "script": "watch:css",
      "detail": "Recompile all css/*.scss on save",
      "isBackground": true,
      "problemMatcher": {
        "owner": "sass",
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Sass is watching for changes"
        }
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Compile SCSS",
      "type": "npm",
      "script": "build:css",
      "detail": "Compile all css/*.scss once",
      "problemMatcher": [],
      "group": "build",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    }
  ]
}
